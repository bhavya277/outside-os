# OUTSIDE//OS Environment Configuration

# Backend Port and Host
HOST=127.0.0.1
PORT=8000

# Local Ollama Inference Host
# Default Ollama daemon port is 11434
OLLAMA_BASE_URL=http://localhost:11434

# Recommended Open-Weight Models:
# - gemma2:2b (Google Gemma 2 - fast, 2.6GB VRAM/RAM, Gemma Terms of Use)
# - qwen2.5:1.5b (Qwen 2.5 - lightweight, 1.8GB VRAM/RAM, Apache 2.0)
# - qwen2.5:3b (Qwen 2.5 - high reasoning, 3.2GB VRAM/RAM, Apache 2.0)
OUTSIDE_MODEL=gemma2:2b

# Ollama inference timeout in seconds (gracefully falls back to offline library if exceeded)
OLLAMA_TIMEOUT=25.0
OLLAMA_MAX_RETRIES=2

# SQLite Local Database File Location
OUTSIDE_DB_PATH=backend/data/outside_os.db

# Frontend API Base URL
VITE_API_BASE=http://localhost:8000
